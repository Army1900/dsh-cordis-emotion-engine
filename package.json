{
  "name": "dsh-cordis-emotion-engine",
  "version": "0.1.0",
  "description": "情绪引擎：DSH Cordis 插件，感知用户情绪并驱动全局动态配色、水波悬浮球与系统提示词注入。",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/index.js"
    },
    "./remote": {
      "types": "./lib/types/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.mjs",
    "lib/index.js",
    "lib/typert.remote-client.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.5.0",
    "zod": "^3.23.0"
  },
  "keywords": [
    "dsh",
    "cordis",
    "emotion",
    "mood",
    "theme",
    "plugin"
  ],
  "license": "MIT"
}
